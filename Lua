task.spawn(function()
    local totalSeconds = 4
    local steps = 40
    local timePerStep = totalSeconds / steps

    for i = 1, steps do
        local progress = i / steps
        local remaining = math.ceil(totalSeconds * (1 - progress))
        
        BarFill.Size = UDim2.new(progress, 0, 1, 0)
        PercentLoadLbl.Text = math.floor(progress * 100) .."%"
        StatusLoadLbl.Text = "Carregando — " .. remaining .. "s restantes"
        
        task.wait(timePerStep)
    end

    StatusLoadLbl.Text = "Pronto para iniciar!"
    PercentLoadLbl.Text = "100%"
    
    ContinueBtn.BackgroundColor3 = Theme.accentStart
    ContinueBtn.TextColor3 = Theme.bg
    ContinueBtn.Text = "Continuar 🚀"
    addGradient(ContinueBtn, Theme.accentStart, Theme.accentEnd, 90)
    
    ContinueBtn.MouseButton1Click:Connect(function()
        local tweenOut = TweenService:Create(LoadGui, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 0, 0, 0),
            Position = LoadGui.Position + UDim2.new(0, 190, 0, 175)  
        })
        tweenOut:Play()
        tweenOut.Completed:Connect(function()
            LoadGui:Destroy()
            MainFrame.Visible = true
            showNotification("Bem-vindo ao Limão Hub Pro!")
        end)
    end)
end)
