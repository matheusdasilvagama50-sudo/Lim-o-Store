SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local text = SearchBox.Text:lower()
    local activeCategories = {}

    for _, item in ipairs(cardElements) do
        if text == "" or item.name:find(text) or item.desc:find(text) then
            item.card.Visible = true
            activeCategories[item.category] = true
        else
            item.card.Visible = false
        end
    end

    for _, cat in ipairs(categoryHeaders) do
        cat.frame.Visible = (text == "" or activeCategories[cat.category] == true)
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.RightShift then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

