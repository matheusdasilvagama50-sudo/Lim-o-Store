local function showNotification(text)
    local mainFrame = ScreenGui:FindFirstChild("MainFrame")
    if not mainFrame then return end

    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 190, 0, 34)
    notif.Position = UDim2.new(1, -200, 1, -44)
    notif.BackgroundColor3 = Theme.header
    notif.BackgroundTransparency = 0
    notif.ZIndex = 2000
    notif.Parent = mainFrame
    addCorner(notif, 8)
    local stroke = addStroke(notif, Theme.accentGlow, 1.5, 0)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -12, 1, 0)
    lbl.Position = UDim2.new(0, 6, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Theme.accentGlow
    lbl.TextSize = 10
    lbl.Font = Enum.Font.GothamBold
    lbl.TextWrapped = true
    lbl.ZIndex = 2001
    lbl.Parent = notif

    task.delay(2.5, function()
        local tweenBg = TweenService:Create(notif, TweenInfo.new(0.25), {BackgroundTransparency = 1})
        TweenService:Create(stroke, TweenInfo.new(0.25), {Transparency = 1}):Play()
        TweenService:Create(lbl, TweenInfo.new(0.25), {TextTransparency = 1}):Play()
        tweenBg:Play()
        tweenBg.Completed:Connect(function() notif:Destroy() end)
    end)
end

