local function updateFavoritesCategory()
    scriptData[1].items = {}
    for _, cat in ipairs(scriptData) do
        if cat.category ~= "⭐ FAVORITADOS" then
            for _, item in ipairs(cat.items) do
                if favorites[item.name] then
                    table.insert(scriptData[1].items, item)
                end
            end
        end
    end
end
updateFavoritesCategory()

local workingCount = 0
local blockedCount = 0

for _, catData in ipairs(scriptData) do
    if catData.category ~= "⭐ FAVORITADOS" then
        for _, item in ipairs(catData.items) do
            if item.outdated then
                blockedCount = blockedCount + 1
            else
                workingCount = workingCount + 1
            end
        end
    end
end

